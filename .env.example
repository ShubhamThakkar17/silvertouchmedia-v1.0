# Public site URL (canonical URLs, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email (Resend): lead notifications and visitor confirmations. Unset = emails skipped.
RESEND_API_KEY=
LEAD_EMAIL_TO=shubham@keshavco.com
LEAD_EMAIL_FROM="Media Planner <plans@yourdomain.com>"

# Google Sheets via Apps Script web app (see integrations/google-apps-script/README.md). Unset = no sheet row.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# Optional alternative to the webhook: a Google service account with edit access to the sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A1

# Cloudflare Turnstile (bot protection on lead forms). Unset = check skipped (dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional shared rate limit across serverless instances (default: in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics (both are off unless set; shown only after consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Stock image fetcher (scripts/fetch-images.ts, dev only)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
