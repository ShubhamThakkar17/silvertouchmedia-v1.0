# Public site URL (canonical URLs, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email (Resend) — lead notifications and visitor confirmations
RESEND_API_KEY=
LEAD_EMAIL_TO=shubham@keshavco.com
LEAD_EMAIL_FROM="Media Planner <plans@yourdomain.com>"

# Google Sheets via Apps Script web app (see integrations/google-apps-script/README.md)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Cloudflare Turnstile (bot protection on lead forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Analytics (both are off unless set; shown only after consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Stock image fetcher (scripts/fetch-images.ts, dev only)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
