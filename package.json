{
  "name": "agency-site-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:brand": "tsx scripts/check-hardcoded-brand.ts",
    "images:brand": "tsx scripts/prepare-brand-images.ts",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "format": "prettier --write .",
    "verify": "pnpm check:brand && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@react-email/render": "2.1.1",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "gray-matter": "4.0.3",
    "lenis": "1.3.11",
    "motion": "12.23.22",
    "next": "15.5.28",
    "next-mdx-remote": "6.0.0",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.62.0",
    "resend": "6.36.1",
    "server-only": "^0.0.1",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.10.1",
    "sharp": "0.34.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/three": "0.180.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
