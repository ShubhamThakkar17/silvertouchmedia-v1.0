{
  "name": "media-agency-template",
  "version": "1.0.0",
  "private": true,
  "description": "Cloneable 360° media agency website template (Next.js App Router).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "check:brand": "tsx scripts/check-hardcoded-brand.ts",
    "check:content": "tsx scripts/validate-content.ts",
    "images:concepts": "tsx scripts/generate-concept-art.ts",
    "images:brand": "tsx scripts/import-brand-images.ts",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "ci": "pnpm check:brand && pnpm check:content && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.27",
    "motion": "^14.13.0",
    "next": "15.5.29",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "^6.39.6",
    "qrcode": "^1.5.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "resend": "^6.38.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  }
}
